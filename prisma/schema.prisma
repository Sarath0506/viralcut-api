generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  url = env("DATABASE_URL")
}

enum UserRole {
  creator

  brand

  admin

  staff
}

enum KycStatus {
  not_started

  pending

  verified

  rejected
}

enum CampaignStatus {
  draft

  live

  paused

  closed
}

enum CampaignWizardStep {
  basics

  brief

  payout

  review
}

enum CampaignOwnership {
  brand_created

  admin_created
}

enum CampaignInviteStatus {
  pending

  accepted

  expired

  revoked
}

enum SubmissionStatus {
  draft_submitted

  under_review

  approved

  awaiting_live_link

  live_tracking

  payout_pending

  paid

  rejected
}

enum FormatDeliverableStatus {
  draft_pending

  under_review

  draft_rejected

  draft_approved

  live_submitted

  proof_under_review

  proof_approved

  proof_rejected
}

enum TransactionType {
  earning_credit

  withdrawal_debit

  fee_debit

  adjustment
}

enum WithdrawalStatus {
  pending

  processing

  completed

  failed
}

enum StaffAccessLevel {
  view_only

  full
}

enum TaskStatus {
  todo

  in_progress

  done
}

enum SupportTicketStatus {
  under_investigation

  resolved
}

enum AdminSection {
  dashboard

  brands

  clippers

  campaigns

  analytics

  tickets

  faqs

  notifications

  team
}

enum AdminPermissionLevel {
  hidden

  view

  manage
}

model User {
  id String @id @default(cuid())

  role UserRole

  email String? @unique

  phone String? @unique

  passwordHash String? @map("password_hash")

  displayName String? @map("display_name")

  avatarUrl String? @map("avatar_url")

  bio String? @db.Text

  socialLinks Json? @map("social_links")

  socialStats Json? @map("social_stats")

  username String? @unique

  fixedOtpCode String? @map("fixed_otp_code") @db.VarChar(6)

  kycStatus KycStatus @default(not_started) @map("kyc_status")

  isActive Boolean @default(true) @map("is_active")

  termsAcceptedAt DateTime? @map("terms_accepted_at")

  kycDocumentUrl String? @map("kyc_document_url")

  kycDocumentType String? @map("kyc_document_type")

  kycSubmittedAt DateTime? @map("kyc_submitted_at")

  kycReviewedAt DateTime? @map("kyc_reviewed_at")

  kycRejectionReason String? @map("kyc_rejection_reason")

  // Null = Super Admin (full, unrestricted access) — the default for every
  // existing admin so assigning this feature never silently locks anyone
  // out. Only set for admins deliberately restricted to a custom role.
  adminRoleId String? @map("admin_role_id")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  brandProfile BrandProfile?

  wallet Wallet?

  submissions Submission[]

  campaignParticipations CampaignParticipation[]

  creatorProfiles CreatorProfile[]

  deliverablesReviewed FormatDeliverable[] @relation("DeliverableReviewedBy")

  deliverableRejections DeliverableRejectionEvent[] @relation("RejectionReviewedBy")

  payoutMethods PayoutMethod[]

  withdrawals Withdrawal[]

  staffBrandAssignments StaffBrandAssignment[] @relation("StaffAssignments")

  refreshTokens RefreshToken[]

  passwordResetTokens PasswordResetToken[]

  campaignsCreated Campaign[] @relation("CampaignCreatedBy")

  campaignInvitesSent CampaignInvite[] @relation("CampaignInviteInviter")

  campaignInvitesAccepted CampaignInvite[] @relation("CampaignInviteAcceptor")

  tasksAssigned Task[] @relation("TaskAssignee")

  tasksCreated Task[] @relation("TaskCreatedBy")

  activityLogs ActivityLog[] @relation("ActivityActor")

  notifications Notification[] @relation("NotificationRecipient")

  deviceTokens DeviceToken[]

  instagramOAuthTransactions InstagramOAuthTransaction[]

  instagramConnections InstagramConnection[]

  youtubeConnections YoutubeConnection[]

  supportTickets SupportTicket[]

  bulkNotificationsSent BulkNotificationLog[]

  adminRole AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)

  @@map("users")
}

model OtpSession {
  id String @id @default(cuid())

  phone String

  codeHash String @map("code_hash")

  expiresAt DateTime @map("expires_at")

  attempts Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, expiresAt])
  @@map("otp_sessions")
}

model RefreshToken {
  id String @id @default(cuid())

  userId String @map("user_id")

  tokenHash String @unique @map("token_hash")

  expiresAt DateTime @map("expires_at")

  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String @map("user_id")

  tokenHash String @unique @map("token_hash")

  expiresAt DateTime @map("expires_at")

  usedAt DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model BrandProfile {
  id String @id @default(cuid())

  userId String @unique @map("user_id")

  companyName String @map("company_name")

  companyEmail String? @map("company_email")

  logoUrl String? @map("logo_url")

  pocName String? @map("poc_name")

  pocPhone String? @map("poc_phone")

  pocEmail String? @map("poc_email")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  campaigns Campaign[]

  staffAssignments StaffBrandAssignment[]

  tasks Task[]

  activityLogs ActivityLog[]

  @@map("brand_profiles")
}

model StaffBrandAssignment {
  id String @id @default(cuid())

  staffUserId String @map("staff_user_id")

  brandProfileId String @map("brand_profile_id")

  accessLevel StaffAccessLevel @default(full) @map("access_level")

  assignedAt DateTime @default(now()) @map("assigned_at")

  staffUser User @relation("StaffAssignments", fields: [staffUserId], references: [id], onDelete: Cascade)

  brandProfile BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, brandProfileId])
  @@index([staffUserId])
  @@index([brandProfileId])
  @@map("staff_brand_assignments")
}

model Task {
  id String @id @default(cuid())

  title String

  description String? @db.Text

  assignedToUserId String @map("assigned_to_user_id")

  createdByUserId String @map("created_by_user_id")

  brandProfileId String? @map("brand_profile_id")

  dueDate DateTime? @map("due_date")

  status TaskStatus @default(todo)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  assignedTo User @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: Cascade)

  createdBy User @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  brandProfile BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  @@index([assignedToUserId])
  @@index([status])
  @@map("tasks")
}

model ActivityLog {
  id String @id @default(cuid())

  actorUserId String @map("actor_user_id")

  action String

  targetType String @map("target_type")

  targetId String @map("target_id")

  brandProfileId String? @map("brand_profile_id")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  actor User @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  brandProfile BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([brandProfileId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Notification {
  id String @id @default(cuid())

  recipientUserId String @map("recipient_user_id")

  type String

  title String

  body String? @db.Text

  link String?

  read Boolean @default(false)

  readAt DateTime? @map("read_at")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  recipient User @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, read])
  @@index([createdAt])
  @@map("notifications")
}

model DeviceToken {
  id String @id @default(cuid())

  userId String @map("user_id")

  token String @unique

  platform String

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Campaign {
  id String @id @default(cuid())

  brandProfileId String? @map("brand_profile_id")

  createdByUserId String? @map("created_by_user_id")

  ownership CampaignOwnership @default(brand_created)

  wizardStep CampaignWizardStep @default(basics) @map("wizard_step")

  inviteAcceptedAt DateTime? @map("invite_accepted_at")

  title String

  category String?

  platform String @default("instagram_reel")

  platforms String[] @default([])

  locationType String @default("pan_india") @map("location_type")

  targetStates String[] @default([]) @map("target_states")

  status CampaignStatus @default(draft)

  brief String @db.Text

  briefHook String? @map("brief_hook") @db.Text

  doRules String? @map("do_rules") @db.Text

  avoidRules String? @map("avoid_rules") @db.Text

  sourceAssets Json? @map("source_assets")

  referenceAssets Json? @map("reference_assets")

  coverImageUrl String? @map("cover_image_url")

  productUrl String? @map("product_url")

  ratePer1kPaise Int @map("rate_per_1k_paise")

  maxPayoutPaise Int @map("max_payout_paise")

  budgetPaise Int @map("budget_paise")

  budgetUsedPaise Int @default(0) @map("budget_used_paise")

  startDate DateTime? @map("start_date")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  brandProfile BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  createdBy User? @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  submissions Submission[]

  participations CampaignParticipation[]

  invites CampaignInvite[]

  @@index([status])
  @@index([brandProfileId])
  @@index([ownership])
  @@map("campaigns")
}

model CampaignInvite {
  id String @id @default(cuid())

  campaignId String @map("campaign_id")

  email String

  tokenHash String @unique @map("token_hash")

  status CampaignInviteStatus @default(pending)

  expiresAt DateTime @map("expires_at")

  acceptedAt DateTime? @map("accepted_at")

  invitedByUserId String @map("invited_by_user_id")

  acceptedByUserId String? @map("accepted_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  invitedBy User @relation("CampaignInviteInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  acceptedBy User? @relation("CampaignInviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([email])
  @@map("campaign_invites")
}

model Submission {
  id String @id @default(cuid())

  campaignId String @map("campaign_id")

  creatorId String @map("creator_id")

  status SubmissionStatus @default(draft_submitted)

  mediaType String @default("video") @map("media_type")

  draftDriveUrl String? @map("draft_drive_url")

  draftStorageKey String? @map("draft_storage_key")

  liveReelUrl String? @map("live_reel_url")

  eligibleViews Int @default(0) @map("eligible_views")

  estimatedPaise Int @default(0) @map("estimated_paise")

  rejectionReason String? @map("rejection_reason")

  submittedAt DateTime @default(now()) @map("submitted_at")

  approvedAt DateTime? @map("approved_at")

  liveLinkAt DateTime? @map("live_link_at")

  paidAt DateTime? @map("paid_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, status])
  @@index([campaignId, status])
  @@map("submissions")
}

model CampaignParticipation {
  id String @id @default(cuid())

  campaignId String @map("campaign_id")

  creatorId String @map("creator_id")

  creatorProfileId String @map("creator_profile_id")

  platformsSnapshot String[] @map("platforms_snapshot")

  joinedAt DateTime @default(now()) @map("joined_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  deliverables FormatDeliverable[]

  @@unique([campaignId, creatorProfileId])
  @@index([creatorId])
  @@index([creatorProfileId])
  @@map("campaign_participations")
}

model CreatorProfile {
  id String @id @default(cuid())

  userId String @map("user_id")

  platform String

  handle String

  label String?

  avatarUrl String? @map("avatar_url")

  isDefault Boolean @default(false) @map("is_default")

  socialLinks Json? @default("{}") @map("social_links")

  socialStats Json? @default("{}") @map("social_stats")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  participations CampaignParticipation[]

  instagramOAuthTransactions InstagramOAuthTransaction[]

  instagramConnections InstagramConnection[]

  youtubeConnections YoutubeConnection[]

  insightSnapshots SocialAccountInsightSnapshot[]

  @@unique([userId, platform, handle])
  @@index([userId])
  @@map("creator_profiles")
}

model InstagramOAuthTransaction {
  id String @id @default(cuid())

  transactionId String @unique @map("transaction_id")

  stateHash String @unique @map("state_hash")

  userId String @map("user_id")

  creatorProfileId String @map("creator_profile_id")

  status String @default("started")

  encryptedAccessToken String? @map("encrypted_access_token") @db.Text

  tokenExpiresAt DateTime? @map("token_expires_at")

  dataAccessExpiresAt DateTime? @map("data_access_expires_at")

  errorCode String? @map("error_code")

  expiresAt DateTime @map("expires_at")

  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([creatorProfileId])
  @@index([expiresAt])
  @@map("instagram_oauth_transactions")
}

model InstagramConnection {
  id String @id @default(cuid())

  userId String @map("user_id")

  creatorProfileId String @unique @map("creator_profile_id")

  platformUserId String @map("platform_user_id")

  platformHandle String @map("platform_handle")

  encryptedAccessToken String @map("encrypted_access_token") @db.Text

  tokenExpiresAt DateTime? @map("token_expires_at")

  dataAccessExpiresAt DateTime? @map("data_access_expires_at")

  followerCount Int @default(0) @map("follower_count")

  followsCount Int @default(0) @map("follows_count")

  mediaCount Int @default(0) @map("media_count")

  engagementRate Float @default(0) @map("engagement_rate")

  profilePictureUrl String? @map("profile_picture_url")

  metadata Json @default("{}")

  isConnected Boolean @default(true) @map("is_connected")

  lastSyncedAt DateTime @default(now()) @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platformUserId])
  @@map("instagram_connections")
}

model YoutubeConnection {
  id String @id @default(cuid())

  userId String @map("user_id")

  creatorProfileId String @unique @map("creator_profile_id")

  platformUserId String @map("platform_user_id")

  platformHandle String @map("platform_handle")

  encryptedAccessToken String @map("encrypted_access_token") @db.Text

  encryptedRefreshToken String? @map("encrypted_refresh_token") @db.Text

  tokenExpiresAt DateTime? @map("token_expires_at")

  subscriberCount Int @default(0) @map("subscriber_count")

  videoCount Int @default(0) @map("video_count")

  totalViewCount Int @default(0) @map("total_view_count")

  engagementRate Float @default(0) @map("engagement_rate")

  profilePictureUrl String? @map("profile_picture_url")

  metadata Json @default("{}")

  isConnected Boolean @default(true) @map("is_connected")

  lastSyncedAt DateTime @default(now()) @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platformUserId])
  @@map("youtube_connections")
}

model FormatDeliverable {
  id String @id @default(cuid())

  participationId String @map("participation_id")

  platform String

  draftDriveUrl String? @map("draft_drive_url")

  livePostUrl String? @map("live_post_url")

  status FormatDeliverableStatus @default(draft_pending)

  rejectionReason String? @map("rejection_reason")

  draftSubmittedAt DateTime? @map("draft_submitted_at")

  draftReviewedAt DateTime? @map("draft_reviewed_at")

  liveSubmittedAt DateTime? @map("live_submitted_at")

  viewCount Int @default(0) @map("view_count")

  reach Int @default(0)

  likeCount Int @default(0) @map("like_count")

  commentCount Int @default(0) @map("comment_count")

  shareCount Int @default(0) @map("share_count")

  proofReviewedAt DateTime? @map("proof_reviewed_at")

  reviewedByUserId String? @map("reviewed_by_user_id")

  paidAt DateTime? @map("paid_at")

  paidAmountPaise Int? @map("paid_amount_paise")

  updatedAt DateTime @updatedAt @map("updated_at")

  participation CampaignParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  reviewedBy User? @relation("DeliverableReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  rejectionEvents DeliverableRejectionEvent[]

  insightSnapshots DeliverableInsightSnapshot[]

  @@unique([participationId, platform])
  @@index([participationId])
  @@index([status])
  @@map("format_deliverables")
}

model DeliverableRejectionEvent {
  id String @id @default(cuid())

  deliverableId String @map("deliverable_id")

  draftDriveUrl String @map("draft_drive_url")

  rejectionReason String @map("rejection_reason")

  reviewedByUserId String? @map("reviewed_by_user_id")

  rejectedAt DateTime @default(now()) @map("rejected_at")

  deliverable FormatDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  reviewedBy User? @relation("RejectionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([deliverableId, rejectedAt])
  @@map("deliverable_rejection_events")
}

model Wallet {
  id String @id @default(cuid())

  userId String @unique @map("user_id")

  availablePaise Int @default(0) @map("available_paise")

  pendingPaise Int @default(0) @map("pending_paise")

  lifetimePaise Int @default(0) @map("lifetime_paise")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id String @id @default(cuid())

  walletId String @map("wallet_id")

  type TransactionType

  amountPaise Int @map("amount_paise")

  referenceId String? @map("reference_id")

  note String?

  createdAt DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("transactions")
}

model PayoutMethod {
  id String @id @default(cuid())

  userId String @map("user_id")

  type String

  label String

  accountHolderName String @map("account_holder_name")

  accountNumber String @map("account_number")

  ifscCode String? @map("ifsc_code")

  bankName String? @map("bank_name")

  accountMasked String @map("account_masked")

  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payout_methods")
}

model Withdrawal {
  id String @id @default(cuid())

  userId String @map("user_id")

  amountPaise Int @map("amount_paise")

  feePaise Int @map("fee_paise")

  netPaise Int @map("net_paise")

  status WithdrawalStatus @default(pending)

  payoutMethodId String? @map("payout_method_id")

  idempotencyKey String? @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  processedAt DateTime? @map("processed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("withdrawals")
}

model SupportTicket {
  id String @id @default(cuid())

  creatorId String @map("creator_id")

  subject String

  message String @db.Text

  status SupportTicketStatus @default(under_investigation)

  resolutionNote String? @map("resolution_note") @db.Text

  resolvedAt DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, status])
  @@map("support_tickets")
}

// Reconstructed from the live database on 2026-08-14 — migration
// 20260811130000_official_insight_snapshots was applied directly to the
// shared DB but never committed (no branch had this model or migration
// file). Fields/constraints below match the live schema exactly.
model DeliverableInsightSnapshot {
  id String @id @default(cuid())

  deliverableId String @map("deliverable_id")

  platform String

  livePostUrl String @map("live_post_url")

  platformMediaId String? @map("platform_media_id")

  viewCount Int @default(0) @map("view_count")

  reach Int @default(0)

  likeCount Int @default(0) @map("like_count")

  commentCount Int @default(0) @map("comment_count")

  shareCount Int @default(0) @map("share_count")

  saveCount Int @default(0) @map("save_count")

  watchTimeSeconds Int @default(0) @map("watch_time_seconds")

  averageViewDurationSeconds Int @default(0) @map("average_view_duration_seconds")

  source String

  status String @default("success")

  errorCode String? @map("error_code")

  rawMetrics Json @default("{}") @map("raw_metrics")

  collectedAt DateTime @default(now()) @map("collected_at")

  deliverable FormatDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId, collectedAt])
  @@index([platform, collectedAt])
  @@map("deliverable_insight_snapshots")
}

model SocialAccountInsightSnapshot {
  id String @id @default(cuid())

  creatorProfileId String @map("creator_profile_id")

  platform String

  platformUserId String @map("platform_user_id")

  handle String

  followerCount Int @default(0) @map("follower_count")

  followingCount Int @default(0) @map("following_count")

  mediaCount Int @default(0) @map("media_count")

  totalViewCount Int @default(0) @map("total_view_count")

  engagementRate Float @default(0) @map("engagement_rate")

  rawMetrics Json @default("{}") @map("raw_metrics")

  source String

  collectedAt DateTime @default(now()) @map("collected_at")

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([creatorProfileId, platform, collectedAt])
  @@index([platform, collectedAt])
  @@map("social_account_insight_snapshots")
}

model BulkNotificationLog {
  id String @id @default(cuid())

  title String

  message String @db.Text

  usedPush Boolean @default(false) @map("used_push")

  usedWhatsapp Boolean @default(false) @map("used_whatsapp")

  recipientIds String[] @map("recipient_ids")

  recipientCount Int @map("recipient_count")

  pushSentCount Int @default(0) @map("push_sent_count")

  pushFailedCount Int @default(0) @map("push_failed_count")

  whatsappSentCount Int @default(0) @map("whatsapp_sent_count")

  whatsappFailedCount Int @default(0) @map("whatsapp_failed_count")

  sentByUserId String @map("sent_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  sentBy User @relation(fields: [sentByUserId], references: [id])

  @@index([createdAt])
  @@map("bulk_notification_logs")
}

model Faq {
  id String @id @default(cuid())

  question String @db.Text

  answer String @db.Text

  order Int @default(0)

  isVisible Boolean @default(true) @map("is_visible")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("faqs")
}

model AdminRole {
  id String @id @default(cuid())

  name String @unique

  canSeeMoney Boolean @default(false) @map("can_see_money")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  permissions AdminSectionPermission[]

  users User[]

  @@map("admin_roles")
}

model AdminSectionPermission {
  id String @id @default(cuid())

  adminRoleId String @map("admin_role_id")

  section AdminSection

  level AdminPermissionLevel @default(hidden)

  adminRole AdminRole @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)

  @@unique([adminRoleId, section])
  @@map("admin_section_permissions")
}
